+  /**
+   * Lista usuarios (ADMINISTRADOR), opcionalmente filtrados por rol y estado.
+   * @param {{ rol?: string, activo?: 'true'|'false' }} filtros
+   */
+  async listUsuarios({ rol, activo } = {}) {
+    const condiciones = [];
+    const params = [];
+    if (rol) {
+      params.push(rol);
+      condiciones.push(`rol = $${params.length}`);
+    }
+    if (activo) {
+      params.push(activo === 'true');
+      condiciones.push(`activo = $${params.length}`);
+    }
+    const where = condiciones.length ? `WHERE ${condiciones.join(' AND ')}` : '';
+    const result = await this.pool.query(
+      `SELECT id, rol, nombres, apellidos, edad, email, telefono, carnet, activo, created_at, updated_at
+       FROM usuarios
+       ${where}
+       ORDER BY created_at DESC, id DESC`,
+      params
+    );
+    return result.rows;
+  }
+
+  /**
+   * Activa o desactiva una cuenta (ADMINISTRADOR). No se borra nada para conservar el historial.
+   * Un usuario desactivado ya no puede iniciar sesión ni renovar su refresh token.
+   * @param {number} id
+   * @param {boolean} activo
+   * @param {number} adminId ID del administrador que hace el cambio
+   */
+  async setActivo(id, activo, adminId) {
+    if (Number(id) === Number(adminId) && !activo) {
+      throw new BadRequestError('No puede desactivar su propia cuenta de administrador');
+    }
+    const usuario = await this.findById(id);
+    if (usuario.rol === 'ADMINISTRADOR' && !activo) {
+      throw new BadRequestError('Las cuentas de administrador no se pueden desactivar desde la aplicación');
+    }
+    const result = await this.pool.query(
+      `UPDATE usuarios
+       SET activo = $1, updated_at = now()
+       WHERE id = $2
+       RETURNING id, rol, nombres, apellidos, edad, email, telefono, carnet, activo, created_at, updated_at`,
+      [activo, id]
+    );
+    return result.rows[0];
+  }
