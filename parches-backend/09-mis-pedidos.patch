+  /**
+   * Lista todos los pedidos del cliente, de todas sus visitas, del más reciente al más antiguo.
+   */
+  async getMisPedidos(usuarioId) {
+    const res = await this.pool.query(
+      `SELECT p.*, rv.codigo_registro, rv.fecha_visita, rv.parque_id, pk.nombre AS parque_nombre
+       FROM pedidos p
+       INNER JOIN registros_visita rv ON rv.id = p.registro_visita_id
+       INNER JOIN parques pk ON pk.id = rv.parque_id
+       WHERE rv.usuario_id = $1
+       ORDER BY p.created_at DESC, p.id DESC`,
+      [usuarioId]
+    );
+
+    return res.rows.map((row) => ({
+      ...row,
+      subtotal: formatMoney(row.subtotal),
+      total: formatMoney(row.total)
+    }));
+  }
