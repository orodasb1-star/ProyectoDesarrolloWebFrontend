diff --git a/services/qr-service/src/services/qr.service.js b/services/qr-service/src/services/qr.service.js
index 3447fa24eecfdea77a51c6f3a1f9bf5b5c4f898e..69862399ae4b6c7b4709222ef25fda5508a87685 100644
--- a/services/qr-service/src/services/qr.service.js
+++ b/services/qr-service/src/services/qr.service.js
@@ -434,6 +434,44 @@ class QrService {
     });
   }
 
+  /**
+   * EMPLEADO: validaciones (exitosas y rechazadas) que hizo en un día, en hora de Guatemala.
+   * @param {number} empleadoId
+   * @param {string} [fecha] YYYY-MM-DD, por defecto hoy
+   */
+  async getMisValidaciones(empleadoId, fecha) {
+    const dia = fecha || this.getTodayGuatemala();
+    const res = await this.pool.query(
+      `SELECT
+         v.id,
+         v.codigo_qr_id,
+         v.resultado,
+         v.observacion,
+         v.fecha_validacion,
+         CASE WHEN q.registro_visita_id IS NOT NULL THEN 'REGISTRO_VISITA' ELSE 'PEDIDO' END AS tipo,
+         ped.numero_pedido,
+         rv.total_personas,
+         pk.nombre AS parque,
+         u.nombres || ' ' || u.apellidos AS titular
+       FROM validaciones_qr v
+       INNER JOIN codigos_qr q ON q.id = v.codigo_qr_id
+       LEFT JOIN pedidos ped ON ped.id = q.pedido_id
+       LEFT JOIN registros_visita rv ON rv.id = COALESCE(q.registro_visita_id, ped.registro_visita_id)
+       LEFT JOIN parques pk ON pk.id = rv.parque_id
+       LEFT JOIN usuarios u ON u.id = rv.usuario_id
+       WHERE v.empleado_id = $1
+         AND (v.fecha_validacion AT TIME ZONE 'America/Guatemala')::date = $2::date
+       ORDER BY v.fecha_validacion DESC`,
+      [empleadoId, dia]
+    );
+    return res.rows.map((r) => ({
+      ...r,
+      referencia: r.resultado === 'RECHAZADO'
+        ? r.observacion
+        : (r.tipo === 'PEDIDO' ? r.numero_pedido : `${r.total_personas} personas`)
+    }));
+  }
+
   /**
    * Tarea programada: pasa a EXPIRADO los QR vencidos.
    */
