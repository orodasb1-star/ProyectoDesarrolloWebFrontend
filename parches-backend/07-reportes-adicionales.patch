+ * Agrega a `condiciones` el filtro de rango de fechas sobre `columna` (fechas inclusivas, hora de Guatemala).
+ */
+function filtroFechas(columna, { fecha_inicio, fecha_fin }, condiciones, params) {
+  const col = `(${columna} AT TIME ZONE 'America/Guatemala')::date`;
+  if (fecha_inicio) {
+    params.push(fecha_inicio);
+    condiciones.push(`${col} >= $${params.length}::date`);
+  }
+  if (fecha_fin) {
+    params.push(fecha_fin);
+    condiciones.push(`${col} <= $${params.length}::date`);
+  }
+}
