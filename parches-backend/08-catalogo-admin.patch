+  /**
+   * ADMINISTRADOR: todos los parques, activos e inactivos (sin caché).
+   */
+  async getTodosLosParques() {
+    const result = await this.pool.query(
+      `SELECT id, nombre, codigo, descripcion, max_personas_carnet, activo, created_at, updated_at
+       FROM parques
+       ORDER BY activo DESC, id ASC`
+    );
+    return result.rows;
+  }
+
+  /**
+   * ADMINISTRADOR: catálogo global de productos con cuántas ofertas en línea tiene cada uno.
+   */
+  async getProductos() {
+    const result = await this.pool.query(
+      `SELECT p.id, p.nombre, p.codigo, p.descripcion, p.tipo, p.activo, p.created_at, p.updated_at,
+              COUNT(pp.id) FILTER (WHERE pp.disponible_online)::int AS ofertas_en_linea
+       FROM productos p
+       LEFT JOIN parque_productos pp ON pp.producto_id = p.id
+       GROUP BY p.id
+       ORDER BY p.activo DESC, p.id ASC`
+    );
+    return result.rows;
+  }
