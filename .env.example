# Puerto en el que se expone el frontend en el navegador (ej: http://localhost:3000)
PORT=3000

# Red Docker externa del backend que ya se encuentra levantado
BACKEND_NETWORK=proyectoirtrabackend_irtra_net

# URL base de la API que usa el navegador. Déjala en /api para pasar por el proxy de Vite
# (desarrollo) o por el Nginx del frontend que reenvía a irtra-api-gateway (docker).
VITE_API_URL=/api

# Destino del proxy de Vite en desarrollo local con npm run dev:
VITE_PROXY_TARGET=https://localhost
